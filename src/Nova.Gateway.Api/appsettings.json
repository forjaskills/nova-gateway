{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tokens": {
    "Emisor": "nova-seguridad",
    "Audiencia": "nova-api"
  },
  "ReverseProxy": {
    "Routes": {
      "seguridad-sesion": {
        "ClusterId": "seguridad",
        "AuthorizationPolicy": "anonymous",
        "RateLimiterPolicy": "estricto",
        "Match": { "Path": "/seguridad/api/v1/sesion", "Methods": [ "POST" ] },
        "Transforms": [ { "PathRemovePrefix": "/seguridad" } ]
      },
      "seguridad-llaves": {
        "ClusterId": "seguridad",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/seguridad/.well-known/jwks.json", "Methods": [ "GET" ] },
        "Transforms": [ { "PathRemovePrefix": "/seguridad" } ]
      },
      "pedidos": {
        "ClusterId": "pedidos",
        "AuthorizationPolicy": "autenticado",
        "Match": { "Path": "/pedidos/api/{**resto}" },
        "Transforms": [ { "PathRemovePrefix": "/pedidos" } ]
      }
    }
  }
}
